#: .\apps\downloads\utils\error_codes.py:73
msgid "An error occurred while processing your download. Please try again."
msgstr "तपाईंको डाउनलोड प्रक्रियामा त्रुटि भयो। कृपया फेरि प्रयास गर्नुहोस्।"

#: .\apps\downloads\utils\error_codes.py:74
msgid "The requested file could not be found."
msgstr "अनुरोध गरिएको फाइल फेला परेन।"

#: .\apps\downloads\utils\error_codes.py:75
msgid "You do not have permission to access this file."
msgstr "तपाईंसँग यो फाइल पहुँच गर्ने अनुमति छैन।"

#: .\apps\downloads\utils\error_codes.py:76
msgid "Too many download requests. Please wait a moment before trying again."
msgstr "धेरै डाउनलोड अनुरोधहरू भए। कृपया फेरि प्रयास गर्नु अघि केही समय पर्खनुहोस्।"

#: .\apps\downloads\utils\error_codes.py:77
msgid "This file has expired and is no longer available."
msgstr "यो फाइलको म्याद समाप्त भइसकेको छ र अब उपलब्ध छैन।"

#: .\apps\downloads\utils\error_codes.py:78
msgid "File type not allowed. Please check the allowed file types."
msgstr ""
"फाइलको प्रकार अनुमति दिइएको छैन। कृपया अनुमति दिइएका फाइल प्रकारहरू जाँच गर्नुहोस्।"

#: .\apps\downloads\utils\error_codes.py:79
msgid "File size exceeds the maximum allowed limit."
msgstr "फाइलको आकार अधिकतम अनुमति दिइएको सीमा भन्दा बढी छ।"

#: .\apps\downloads\utils\error_codes.py:80
msgid "An error occurred while uploading the file. Please try again."
msgstr "फाइल अपलोड गर्दा त्रुटि भयो। कृपया फेरि प्रयास गर्नुहोस्।"

#: .\apps\downloads\utils\error_codes.py:81
msgid "An error occurred while creating the bulk download. Please try again."
msgstr "एकमुष्ठ डाउनलोड सिर्जना गर्दा त्रुटि भयो। कृपया फेरि प्रयास गर्नुहोस्।"

#: .\apps\downloads\utils\error_codes.py:82
msgid "No files selected for bulk download."
msgstr "एकमुष्ठ डाउनलोडका लागि कुनै पनि फाइल छानिएको छैन।"

#: .\apps\downloads\utils\error_codes.py:83
msgid "Too many files selected. Please select fewer files."
msgstr "धेरै फाइलहरू छानिएका छन्। कृपया थोरै फाइलहरू छान्नुहोस्।"

#: .\apps\downloads\utils\error_codes.py:84
msgid "The file was flagged as potentially unsafe and cannot be downloaded."
msgstr "फाइल सम्भावित असुरक्षित भएको कारण डाउनलोड गर्न सकिएन।"

#: .\apps\downloads\utils\error_codes.py:85
msgid "Your IP address has been temporarily blocked due to security reasons."
msgstr "तपाईंको IP ठेगाना सुरक्षा कारणले गर्दा अस्थायी रूपमा रोकिएको छ।"

#: .\apps\downloads\utils\error_codes.py:86
msgid "File integrity check failed. The file may have been tampered with."
msgstr "फाइलको अखण्डता जाँच असफल भयो। फाइलमा परिवर्तन गरिएको हुन सक्छ।"

#: .\apps\downloads\utils\error_codes.py:87
msgid "A database error occurred. Please try again later."
msgstr "डाटाबेस त्रुटि भयो। कृपया पछि फेरि प्रयास गर्नुहोस्।"

#: .\apps\downloads\utils\error_codes.py:88
msgid "Invalid request. Please try again."
msgstr "अवैध अनुरोध। कृपया फेरि प्रयास गर्नुहोस्।"

#: .\apps\downloads\utils\error_codes.py:89
msgid "This endpoint only accepts AJAX requests."
msgstr "यो अन्तिम बिन्दुले AJAX अनुरोधहरू मात्र स्वीकार गर्दछ।"

#: .\apps\downloads\utils\error_codes.py:91
msgid "An unexpected error occurred. Please try again."
msgstr "एक अप्रत्याशित त्रुटि भयो। कृपया फेरि प्रयास गर्नुहोस्।"
