# Bhanjyang Cooperative Environment Configuration
# Copy this file to .env and update the values for your environment

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
SECRET_KEY=your-super-secret-key-here-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,192.168.1.82,192.168.1.117,192.168.1.74,192.168.0.22,localhost

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# For development (SQLite)
# DATABASE_URL=sqlite:///db.sqlite3

# For production (PostgreSQL)
DB_NAME=bhanjyang_coop
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
SEND_REAL_EMAILS=False
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
ADMIN_EMAIL=admin@bhanjyangcoop.com
DEVELOPER_EMAIL=developer@bhanjyangcoop.com

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5555,http://localhost:5555,http://192.168.1.82:5555,http://192.168.1.82:8000,http://192.168.1.74:8000,http://192.168.0.22:5555,http://192.168.0.22:8000

# =============================================================================
# CORS SETTINGS
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
ENVIRONMENT=development
RELEASE_VERSION=1.0.0

# =============================================================================
# FILE UPLOAD SETTINGS
# =============================================================================
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
DATA_UPLOAD_MAX_NUMBER_FIELDS=1000

# =============================================================================
# CACHE SETTINGS
# =============================================================================
CACHE_TIMEOUT=300
CACHE_MAX_ENTRIES=1000

# =============================================================================
# API SETTINGS
# =============================================================================
API_RATE_LIMIT_ANON=100
API_RATE_LIMIT_USER=1000

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Set to True to enable debug toolbar
ENABLE_DEBUG_TOOLBAR=True

# Set to True to enable Django extensions
ENABLE_DJANGO_EXTENSIONS=True

# =============================================================================
# PRODUCTION SETTINGS (Override for production)
# =============================================================================
# DEBUG=False
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SEND_REAL_EMAILS=True
# ENVIRONMENT=production
